---
import DashboardLayout from "../../layouts/DashboardLayout.astro";

const FIELDS = [
  { id: "org", label: "Legal name", defaultValue: "Acme Notes, Inc." },
  { id: "contact", label: "Primary counsel email", defaultValue: "counsel@acmenotes.example" },
  { id: "sub", label: "Disclosure subdomain", defaultValue: "acme-notes", suffix: ".disclosur.co" },
  { id: "reg", label: "Jurisdiction", defaultValue: "Delaware, USA" },
];

const TOGGLES = [
  { title: "New disclosure gaps", description: "Email me when a scan surfaces a new high-severity gap.", defaultChecked: true },
  { title: "Regulatory updates", description: "Weekly digest of changes to SB 53, AB 853, and EU AI Act guidance.", defaultChecked: true },
  { title: "Packet exports", description: "Notify counsel when a new packet version is exported.", defaultChecked: false },
];
---
<DashboardLayout title="Settings — TransparentAI">
  <div class="space-y-6">
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-accent">Workspace</div>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-primary">Settings</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Manage your workspace, disclosure subdomain, and notification preferences.
      </p>
    </div>

    <div class="rounded-lg border border-border bg-card p-6">
      <div class="text-sm font-semibold text-primary">Organization</div>
      <div class="my-4 h-px w-full bg-border"></div>
      <div class="grid gap-4 md:grid-cols-2">
        {FIELDS.map((f) => (
          <div>
            <label for={f.id} class="text-xs text-muted-foreground">{f.label}</label>
            <div class="mt-1.5 flex items-center gap-2">
              <input id={f.id} value={f.defaultValue} class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm" />
              {f.suffix && <span class="text-sm text-muted-foreground">{f.suffix}</span>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-lg border border-border bg-card p-6">
      <div class="text-sm font-semibold text-primary">Notifications</div>
      <div class="my-4 h-px w-full bg-border"></div>
      <div class="space-y-4">
        {TOGGLES.map((t) => (
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="text-sm font-medium text-primary">{t.title}</div>
              <div class="text-xs text-muted-foreground">{t.description}</div>
            </div>
            <label class="relative inline-flex h-6 w-11 cursor-pointer items-center">
              <input type="checkbox" class="peer sr-only" checked={t.defaultChecked} />
              <span class="h-6 w-11 rounded-full bg-muted peer-checked:bg-accent"></span>
            </label>
          </div>
        ))}
      </div>
    </div>

    <div class="rounded-lg border border-border bg-card p-6">
      <div class="text-sm font-semibold text-primary">Danger zone</div>
      <div class="my-4 h-px w-full bg-border"></div>
      <div class="flex items-center justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-primary">Delete workspace</div>
          <div class="text-xs text-muted-foreground">
            Permanently removes all questionnaire data and exported packets.
          </div>
        </div>
        <button class="inline-flex items-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-destructive hover:bg-destructive/10">
          Delete workspace
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>
